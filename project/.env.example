# 네이버 검색 API 자격증명
#
# 2026-07-31 부로 구 네이버 개발자센터(developers.naver.com)에서는
# 검색 API 신규 신청이 차단되었습니다. 신규 발급은 NAVER API HUB 를 이용하세요.
#
#   네이버 클라우드 플랫폼 콘솔 → Menu → All Services
#   → Application Services → NAVER API HUB → 신청하기
#   → Application 등록 → 사용할 API 선택(블로그/카페글/지역 검색)
#   → [인증 정보] 에서 Client ID / Client Secret 확인
#
# 발급 후 `python -m sma doctor` 로 동작을 확인하세요.
# 실제 값은 .env 에 넣고 커밋하지 마세요.

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# apihub      : NAVER API HUB (기본값, 신규 발급 키)
# developers  : 구 개발자센터 (2027-06-30 종료, 기존 키 보유자만)
NAVER_API_BACKEND=apihub
